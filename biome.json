{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "enabled": true, "rules": { "recommended": true } },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "files": {
    "includes": [
      "**",
      "!dist",
      "!node_modules",
      "!src/generated",
      "!graphify-out",
      "!.remember",
      "!.superpowers",
      "!docs/openapi.json"
    ]
  }
}
