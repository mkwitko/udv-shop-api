generator client {
  provider      = "prisma-client-js"
  /// `native` cobre a máquina de quem desenvolve. O alvo de produção é declarado explícito
  /// porque a detecção do Prisma depende da libssl presente no momento do `generate`: numa
  /// imagem slim sem openssl ele cai no default 1.1.x e o container sobe, migra e só então
  /// morre com "could not locate the Query Engine for runtime linux-arm64-openssl-3.0.x".
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  /// Nulável desde o fluxo sem conta: quem chega para pedir aviso, doar ou comprar pode
  /// entrar só com telefone. Continua único, então segue servindo de chave de login.
  email         String?  @unique
  passwordHash  String?  @map("password_hash")
  googleId      String?  @unique @map("google_id")
  name          String
  /// Único e normalizado (dígitos com DDI: "5511988887777"). É a chave de identidade de
  /// quem chega sem e-mail — e o canal que a loja usa para avisar essa pessoa.
  phone         String?  @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  platformAdmin Boolean  @default(false) @map("platform_admin")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  emailTokens   EmailToken[]
  storeRoles    UserStoreRole[]
  orders        Order[]
  interests     Interest[]
  donations     Donation[]
  raffleEntries RaffleEntry[]
  settlements   SupplierSettlement[]

  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

enum EmailTokenType {
  verify_email
  password_reset
}

model EmailToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  type      EmailTokenType
  tokenHash String         @unique @map("token_hash")
  expiresAt DateTime       @map("expires_at")
  usedAt    DateTime?      @map("used_at")
  createdAt DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

enum StoreStatus {
  pending
  active
  suspended
}

/// Por que a loja está suspensa. Sem isso, `suspended` é ambíguo: assinatura vencida e
/// moderação da plataforma viram o mesmo estado, e a loja que volta a pagar fica presa
/// fora do ar esperando um platform_admin.
enum StoreSuspensionReason {
  billing
  platform
}

/// Espelha os status de Subscription do Stripe que nos interessam. `incomplete` é o
/// estado entre o checkout iniciado e o primeiro pagamento confirmado.
enum StoreSubscriptionStatus {
  incomplete
  trialing
  active
  past_due
  canceled
}

enum StoreRole {
  owner
  admin
  staff
}

/// Estado da prova de posse da chave Pix da loja.
///
/// `legacy` é a chave que já estava gravada quando a verificação passou a existir: segue
/// recebendo (tirar do ar quem já vendia seria pior que o risco) mas a gestão pede a
/// prova. `pending` não recebe: é justamente a chave de terceiro usada como fantoche que
/// a verificação existe para barrar.
enum WooviPixKeyStatus {
  legacy
  pending
  verified
}

/// Uma tentativa de provar posse da chave: a loja paga R$ 0,01 DA CONTA DA CHAVE para a
/// plataforma, e o webhook diz de quem é a conta que pagou.
enum WooviPixKeyVerificationStatus {
  pending
  verified
  /// Pagou, mas de uma conta de outro CPF/CNPJ — é exatamente o caso que barramos.
  rejected
  expired
}

enum ProductAvailability {
  in_stock
  on_demand
}

/// Fila de espera, de produto esgotado ou de evento lotado. O nome não diz "product"
/// porque a fila nunca foi só de produto: quem quer vaga em sessão lotada espera igual.
enum InterestStatus {
  open
  notified
  converted
  cancelled
}

model Store {
  id                     String                 @id @default(uuid()) @db.Uuid
  slug                   String                 @unique
  name                   String
  description            String?
  branding               Json?
  status                 StoreStatus            @default(pending)
  /// Só faz sentido junto de `status = suspended`; nula em qualquer outro estado.
  suspensionReason       StoreSuspensionReason? @map("suspension_reason")
  isPlatformOwner        Boolean                @default(false) @map("is_platform_owner")
  /// Taxa por venda em basis points. Zero desde 2026-08-19: a plataforma se sustenta pela
  /// mensalidade da loja, não por comissão (ADR-027). O campo continua existindo por loja
  /// para o caso de a decisão comercial voltar atrás sem migração de dados.
  applicationFeeBps      Int                    @default(0) @map("application_fee_bps")
  /// WhatsApp público da loja, só dígitos com DDI ("5548999995678"). É o caminho de volta
  /// de quem compra: sem ele a pessoa pagava e não tinha como falar com quem vende.
  whatsapp               String?                @map("whatsapp")
  /// Como a loja entrega, na linguagem dela ("retirada no núcleo, sábado de manhã").
  /// Texto livre porque combinação de entrega em comunidade não cabe em enum — e sem isso
  /// a promessa "combinado com a loja" não dizia com quem nem como.
  deliveryNote           String?                @map("delivery_note")
  /// Domínio próprio da loja (ex.: "loja.comunidade.org"), único na plataforma. Só
  /// resolve para a loja depois de verificado — antes disso é intenção, não endereço.
  customDomain           String?                @unique @map("custom_domain")
  customDomainVerifiedAt DateTime?              @map("custom_domain_verified_at")

  stripeAccountId       String?            @unique @map("stripe_account_id")
  /// Único porque na Woovi a subconta É a chave Pix: `getSubAccount(pixKey)` e
  /// `withdrawSubAccount(pixKey)` não têm id separado. Duas lojas com a mesma chave
  /// operariam a mesma subconta — a segunda veria o saldo da primeira e poderia esvaziá-lo
  /// na hora que quisesse (o dinheiro vai para a chave, mas reembolso sai da subconta, e
  /// subconta vazia é reembolso pago pela plataforma). Unicidade não é posse: quem prova
  /// que a chave é sua é `wooviPixKeyStatus` (ver WooviPixKeyVerification).
  wooviPixKey           String?            @unique @map("woovi_pix_key")
  /// Nulo quando não há chave. Só `verified` e `legacy` recebem split no checkout.
  wooviPixKeyStatus     WooviPixKeyStatus? @map("woovi_pix_key_status")
  /// Dono da chave conforme o DICT (`POST /api/v1/pix-keys/check`), no momento em que a
  /// chave foi gravada. Nome vem inteiro; taxID vem mascarado quando é CPF. Guardado para
  /// a loja conferir na tela ("essa chave é de FULANO — confere?") e para comparar com
  /// quem pagar o centavo da verificação.
  wooviPixKeyOwnerName  String?            @map("woovi_pix_key_owner_name")
  wooviPixKeyOwnerTaxId String?            @map("woovi_pix_key_owner_tax_id")
  wooviPixKeyVerifiedAt DateTime?          @map("woovi_pix_key_verified_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  // Capacidades da conta conectada, espelhadas do webhook account.updated. Onboarding
  // iniciado não é onboarding concluído: só com stripeTransfersEnabled a loja pode vender.
  // Em destination charge quem cobra é a PLATAFORMA — chargesEnabled fala da conta do
  // núcleo cobrar direto, que não é o nosso fluxo. O que precisa estar ativo para o
  // dinheiro chegar no núcleo é a capability `transfers`.
  stripeTransfersEnabled  Boolean @default(false) @map("stripe_transfers_enabled")
  /// Product da plataforma que representa "doação mensal desta loja". Nasce na primeira
  /// assinatura e é reusado nas seguintes — um Product por doação enchia a conta de lixo.
  stripeDonationProductId String? @map("stripe_donation_product_id")
  stripeChargesEnabled    Boolean @default(false) @map("stripe_charges_enabled")
  stripePayoutsEnabled    Boolean @default(false) @map("stripe_payouts_enabled")
  stripeDetailsSubmitted  Boolean @default(false) @map("stripe_details_submitted")
  wooviSubaccountId       String? @map("woovi_subaccount_id")

  roles              UserStoreRole[]
  pixKeyVerification WooviPixKeyVerification[]
  products           Product[]
  events             Event[]
  categories         ProductCategory[]
  orders             Order[]
  campaigns          Campaign[]
  donations          Donation[]
  subscription       StoreSubscription?
  suppliers          Supplier[]
  settlements        SupplierSettlement[]

  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@map("stores")
}

/// Prova de posse da chave Pix. A loja paga R$ 0,01 para a plataforma DA CONTA DA CHAVE
/// que declarou, e o webhook da cobrança traz o CPF/CNPJ de quem pagou — comparado com o
/// dono da chave no DICT. É o que separa "declarei uma chave" de "essa chave é minha".
///
/// Sem isto, alguém cadastra a chave de um terceiro e as vendas dele caem na conta de um
/// inocente: o dinheiro nunca é roubado (Pix sempre cai na chave), mas a trilha do golpe
/// aponta para quem não fez nada.
///
/// O `id` é o `correlationID` da cobrança na Woovi — é assim que o webhook volta para cá.
model WooviPixKeyVerification {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @map("store_id") @db.Uuid
  /// Chave declarada no momento da tentativa. Fica registrada porque trocar de chave
  /// invalida a prova: a tentativa antiga não vale para a chave nova.
  pixKey  String @map("pix_key")

  /// Dono da chave no DICT quando a tentativa começou.
  ownerName  String @map("owner_name")
  ownerTaxId String @map("owner_tax_id")

  amountCents Int    @map("amount_cents")
  brCode      String @map("br_code")
  qrCodeUrl   String @map("qr_code_url")

  status           WooviPixKeyVerificationStatus @default(pending)
  /// Quem pagou, do webhook. O CPF/CNPJ é gravado MASCARADO: para auditar a recusa basta
  /// saber que era outra pessoa — guardar o documento inteiro de um terceiro não.
  payerName        String?                       @map("payer_name")
  payerTaxIdMasked String?                       @map("payer_tax_id_masked")
  expiresAt        DateTime                      @map("expires_at")
  settledAt        DateTime?                     @map("settled_at")
  createdAt        DateTime                      @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt(sort: Desc)])
  @@map("woovi_pix_key_verifications")
}

/// Assinatura SaaS do núcleo, cobrada na conta da PLATAFORMA (não é Connect: ver ADR-019).
/// Uma por loja — o `@unique` em storeId é o que impede dois checkouts concorrentes
/// virarem duas assinaturas cobradas.
model StoreSubscription {
  id                   String                  @id @default(uuid()) @db.Uuid
  storeId              String                  @unique @map("store_id") @db.Uuid
  stripeCustomerId     String                  @map("stripe_customer_id")
  stripeSubscriptionId String?                 @unique @map("stripe_subscription_id")
  priceId              String?                 @map("price_id")
  status               StoreSubscriptionStatus @default(incomplete)
  currentPeriodEnd     DateTime?               @map("current_period_end")
  cancelAtPeriodEnd    Boolean                 @default(false) @map("cancel_at_period_end")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_subscriptions")
}

model UserStoreRole {
  userId    String    @map("user_id") @db.Uuid
  storeId   String    @map("store_id") @db.Uuid
  role      StoreRole
  createdAt DateTime  @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@index([storeId])
  @@map("user_store_roles")
}

model Product {
  id           String              @id @default(uuid()) @db.Uuid
  storeId      String              @map("store_id") @db.Uuid
  slug         String
  name         String
  description  String?
  priceCents   Int                 @map("price_cents")
  currency     String              @default("BRL")
  images       String[]            @default([])
  stock        Int                 @default(0)
  availability ProductAvailability @default(in_stock)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  /// Gaveta da vitrine. Opcional de propósito: loja pequena não precisa classificar
  /// nada, e apagar uma categoria não pode apagar produto (SetNull).
  categoryId String? @map("category_id") @db.Uuid

  /// Acordo de repasse vigente. Vale para vendas futuras: cada OrderItem congela o
  /// valor no momento da compra, então mudar o acordo não reescreve o passado.
  supplierId  String?     @map("supplier_id") @db.Uuid
  payoutKind  PayoutKind? @map("payout_kind")
  payoutValue Int?        @map("payout_value")

  store      Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier   Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]
  interests  Interest[]

  @@unique([storeId, slug])
  @@index([storeId, active, createdAt(sort: Desc), id(sort: Desc)])
  /// Vitrine filtrada por categoria, paginada pelo mesmo keyset da vitrine inteira.
  @@index([storeId, categoryId, active, createdAt(sort: Desc), id(sort: Desc)])
  /// Ordenação por preço tem cursor próprio (priceCents + id) e precisa do índice dela.
  @@index([storeId, active, priceCents, id])
  @@index([supplierId])
  @@map("products")
}

/// Gaveta da vitrine, por loja. Nome é o que a comunidade escreve ("Chás", "Artesanato"),
/// slug é o que viaja na URL. `position` existe porque ordem alfabética não é ordem de
/// importância: a loja decide o que aparece primeiro.
model ProductCategory {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  slug      String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, slug])
  @@index([storeId, position])
  @@map("product_categories")
}

/// Fila de espera: "avise quando voltar" de produto esgotado e "avise se abrir vaga" de
/// evento lotado. Aponta para UM dos dois — o banco garante isso por CHECK, porque um
/// interesse sem alvo (ou com os dois) não tem o que notificar.
model Interest {
  id         String         @id @default(uuid()) @db.Uuid
  productId  String?        @map("product_id") @db.Uuid
  eventId    String?        @map("event_id") @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  qty        Int            @default(1)
  status     InterestStatus @default(open)
  note       String?
  notifiedAt DateTime?      @map("notified_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  event   Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Uma pessoa entra uma vez na fila de cada coisa. São dois uniques porque a coluna do
  /// outro alvo é nula, e nulo não colide com nulo no Postgres: o par de índices cobre os
  /// dois casos sem se atrapalhar.
  @@unique([productId, userId])
  @@unique([eventId, userId])
  @@index([productId, status])
  @@index([eventId, status])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("interests")
}

/// Evento: sessão, festa, mutirão, curso. Tem dia, hora e lugar, e o que se vende é vaga.
///
/// Já foi produto com `event_at` preenchido. Reusava preço, estoque e checkout, mas custava
/// caro em todo lugar: a vitrine tinha de filtrar evento fora, "estoque" queria dizer vaga,
/// e a tela de produto dizia "Este produto está esgotado" para uma sessão lotada. O que não
/// cabia no molde de produto era justamente o que define evento — data que vence.
model Event {
  id          String   @id @default(uuid()) @db.Uuid
  storeId     String   @map("store_id") @db.Uuid
  slug        String
  name        String
  description String?
  /// Preço e vagas DO EVENTO, usados quando ele não tem lotes. Com lotes, quem manda é o
  /// lote ativo (ver EventBatch) e estes dois campos ficam parados — a resposta da API já
  /// devolve o número que vale agora, para nenhuma tela ter de escolher entre os dois.
  priceCents  Int      @map("price_cents")
  currency    String   @default("BRL")
  images      String[] @default([])
  /// Vagas restantes. É o que o checkout reserva e o que a lista de presença devolve — não
  /// se chama `stock` porque ninguém tem "estoque" de mutirão.
  seats       Int      @default(0)

  at       DateTime
  /// Fim opcional: quando existe, é ele que decide se o evento já passou.
  endsAt   DateTime? @map("ends_at")
  location String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Repasse a quem conduz (facilitadora, oficineiro), igual ao de produto: cada OrderItem
  /// congela o valor na venda, então mudar o acordo não reescreve o passado.
  supplierId  String?     @map("supplier_id") @db.Uuid
  payoutKind  PayoutKind? @map("payout_kind")
  payoutValue Int?        @map("payout_value")

  store      Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier   Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]
  interests  Interest[]
  batches    EventBatch[]

  @@unique([storeId, slug])
  /// Agenda: o que ainda vai acontecer, em ordem de data.
  @@index([storeId, active, at])
  @@index([supplierId])
  @@map("events")
}

/// Lote de vagas: "1º lote R$ 30", "2º lote R$ 40". Vende em etapas, uma por vez, na ordem
/// de `position` — e é a forma como evento de comunidade enche antes da hora, porque quem
/// compra cedo paga menos.
///
/// O lote ativo é o primeiro que ainda tem vaga E está dentro da janela dele. Sem lote, o
/// evento vende pelo próprio preço: o caso simples (mutirão a R$ 10) não paga o preço de
/// cadastrar lote nenhum.
model EventBatch {
  id         String @id @default(uuid()) @db.Uuid
  eventId    String @map("event_id") @db.Uuid
  /// Como aparece para quem compra: "1º lote", "Promocional", "Últimas vagas".
  name       String
  /// Ordem de venda. Dois lotes na mesma posição seriam um empate sem critério.
  position   Int
  priceCents Int    @map("price_cents")
  /// Vagas restantes NESTE lote. Zero é lote esgotado, e o próximo assume.
  seats      Int    @default(0)

  /// Janela opcional. `opensAt` no futuro segura o lote; `closesAt` no passado o encerra
  /// mesmo com vaga sobrando — é o "1º lote até dia 30" que existe para criar urgência.
  opensAt  DateTime? @map("opens_at")
  closesAt DateTime? @map("closes_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([eventId, position])
  @@index([eventId])
  @@map("event_batches")
}

/// Como o repasse de um produto é calculado: valor fixo por unidade vendida ou
/// percentual do preço (em basis points, mesma unidade de applicationFeeBps).
enum PayoutKind {
  fixed_cents
  percent_bps
}

/// Quem recebe repasse de uma venda: artesã, produtor, fornecedor da comunidade.
/// O dinheiro da venda cai na conta da loja (direct charge, ADR-019) — este cadastro
/// registra quanto a loja deve a quem, não é um destino de pagamento automático.
model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  name      String
  phone     String?
  pixKey    String?  @map("pix_key")
  note      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store       Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products    Product[]
  events      Event[]
  orderItems  OrderItem[]
  settlements SupplierSettlement[]

  @@unique([storeId, name])
  @@index([storeId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("suppliers")
}

/// Um repasse que a loja já pagou. O saldo devido é derivado: soma dos
/// `order_items.payout_cents` de pedidos pagos menos a soma daqui. Nada de saldo
/// materializado — duas fontes de verdade para dinheiro sempre divergem.
model SupplierSettlement {
  id          String   @id @default(uuid()) @db.Uuid
  storeId     String   @map("store_id") @db.Uuid
  supplierId  String   @map("supplier_id") @db.Uuid
  amountCents Int      @map("amount_cents")
  note        String?
  paidAt      DateTime @map("paid_at")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier  Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([supplierId, paidAt(sort: Desc), id(sort: Desc)])
  @@index([storeId, paidAt(sort: Desc), id(sort: Desc)])
  @@map("supplier_settlements")
}

enum OrderStatus {
  pending_payment
  paid
  delivery_arranged
  delivered
  cancelled
  refunded
}

enum PaymentProvider {
  stripe
  woovi
}

enum PaymentStatus {
  pending
  succeeded
  failed
  expired
  cancelled
  refunded
  refund_pending
}

enum WebhookEventStatus {
  received
  processed
  failed
}

enum OutboxStatus {
  pending
  processing
  processed
  failed
}

model Order {
  id           String      @id @default(uuid()) @db.Uuid
  storeId      String      @map("store_id") @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  status       OrderStatus @default(pending_payment)
  totalCents   Int         @map("total_cents")
  currency     String      @default("BRL")
  contactPhone String      @map("contact_phone")
  note         String?
  /// Chave do recibo público. Preenchida só quando o pedido nasce sem sessão: é como a tela
  /// de confirmação acompanha o Pix sem estar autenticada. Não é credencial de conta.
  publicToken  String?     @unique @map("public_token")
  expiresAt    DateTime    @map("expires_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  store   Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id])
  items   OrderItem[]
  payment Payment?

  @@index([storeId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, expiresAt])
  @@map("orders")
}

/// Uma linha da compra. Aponta para um produto OU para um evento — nunca os dois, nunca
/// nenhum; o banco garante por CHECK. `name` e `priceCents` ficam copiados aqui de
/// propósito: o recibo tem de continuar dizendo o que foi comprado e por quanto mesmo
/// depois de a loja renomear ou reajustar.
model OrderItem {
  id           String  @id @default(uuid()) @db.Uuid
  orderId      String  @map("order_id") @db.Uuid
  productId    String? @map("product_id") @db.Uuid
  eventId      String? @map("event_id") @db.Uuid
  /// De qual lote a vaga saiu. Só existe em item de evento com lotes, e é o que permite
  /// dizer depois quanto cada lote rendeu — o preço já fica congelado em `priceCents`.
  eventBatchId String? @map("event_batch_id") @db.Uuid
  name         String
  priceCents   Int     @map("price_cents")
  qty          Int

  /// Repasse congelado na venda, já multiplicado pela quantidade. Zero quando o
  /// produto não tem parceiro — a loja fica com tudo menos a taxa.
  supplierId  String? @map("supplier_id") @db.Uuid
  payoutCents Int     @default(0) @map("payout_cents")

  /// Presença confirmada na porta, quando o item comprado é ingresso de evento. Fica no
  /// item e não no pedido porque a lista de presença é por evento: um pedido pode levar
  /// ingresso de dois eventos diferentes.
  checkedInAt DateTime? @map("checked_in_at")

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product?    @relation(fields: [productId], references: [id])
  event      Event?      @relation(fields: [eventId], references: [id])
  eventBatch EventBatch? @relation(fields: [eventBatchId], references: [id])
  supplier   Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([eventId])
  @@index([eventBatchId])
  @@index([supplierId])
  @@map("order_items")
}

model Payment {
  id                  String          @id @default(uuid()) @db.Uuid
  orderId             String?         @unique @map("order_id") @db.Uuid
  donationId          String?         @unique @map("donation_id") @db.Uuid
  provider            PaymentProvider
  providerId          String?         @map("provider_id")
  /// Cobrança Pix como o provedor devolveu. Persistida porque o Pix fica minutos na tela
  /// esperando: sem isso um F5 perde o QR code e a pessoa fica com um pagamento pendente e
  /// nenhum jeito de pagá-lo. Cartão não entra aqui — é síncrono, e o clientSecret morre com
  /// a tentativa.
  pixBrCode           String?         @map("pix_br_code")
  pixQrCodeUrl        String?         @map("pix_qr_code_url")
  amountCents         Int             @map("amount_cents")
  applicationFeeCents Int             @map("application_fee_cents")
  status              PaymentStatus   @default(pending)
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  order    Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  donation Donation? @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("payments")
}

model WebhookEvent {
  id          String             @id @default(uuid()) @db.Uuid
  provider    PaymentProvider
  eventId     String             @map("event_id")
  type        String
  payload     Json
  status      WebhookEventStatus @default(received)
  error       String?
  processedAt DateTime?          @map("processed_at")
  createdAt   DateTime           @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@index([status, createdAt])
  @@map("webhook_events")
}

model OutboxEvent {
  id          String       @id @default(uuid()) @db.Uuid
  type        String
  payload     Json
  status      OutboxStatus @default(pending)
  attempts    Int          @default(0)
  processedAt DateTime?    @map("processed_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  claimedAt   DateTime?    @map("claimed_at")
  claimedBy   String?      @map("claimed_by")

  @@index([status, createdAt])
  @@map("outbox_events")
}

enum CampaignStatus {
  draft
  active
  paused
  finished
}

enum CampaignAcceptedTypes {
  one_time
  monthly
  both
}

enum DonationType {
  one_time
  monthly
}

enum DonationStatus {
  pending_payment
  paid
  failed
  cancelled
  refunded
}

enum RaffleStatus {
  open
  drawn
  cancelled
}

model Campaign {
  id            String                @id @default(uuid()) @db.Uuid
  storeId       String                @map("store_id") @db.Uuid
  slug          String
  title         String
  story         String?
  coverImage    String?               @map("cover_image")
  goalCents     Int?                  @map("goal_cents")
  acceptedTypes CampaignAcceptedTypes @default(both) @map("accepted_types")
  status        CampaignStatus        @default(draft)
  endsAt        DateTime?             @map("ends_at")
  /// Arquivada sai das listagens sem perder a história: `status` continua sendo o que
  /// aconteceu com a campanha (encerrada), e isto é só onde ela aparece.
  archivedAt    DateTime?             @map("archived_at")
  /// Galeria da campanha. `coverImage` é a escolhida para capa e é uma destas.
  images        String[]              @default([])
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  donations Donation[]
  raffles   Raffle[]

  @@unique([storeId, slug])
  @@index([storeId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@map("campaigns")
}

model Donation {
  id                      String         @id @default(uuid()) @db.Uuid
  storeId                 String         @map("store_id") @db.Uuid
  campaignId              String?        @map("campaign_id") @db.Uuid
  userId                  String         @map("user_id") @db.Uuid
  type                    DonationType   @default(one_time)
  amountCents             Int            @map("amount_cents")
  currency                String         @default("BRL")
  status                  DonationStatus @default(pending_payment)
  anonymous               Boolean        @default(false)
  message                 String?
  subscriptionRef         String?        @map("subscription_ref")
  providerInvoiceId       String?        @unique @map("provider_invoice_id")
  subscriptionCancelledAt DateTime?      @map("subscription_cancelled_at")
  raffleGranted           Boolean        @default(false) @map("raffle_granted")
  /// Chave do recibo público. Preenchida só quando a doação nasce sem sessão: é como a tela
  /// de confirmação acompanha o Pix sem estar autenticada. Não é credencial de conta.
  publicToken             String?        @unique @map("public_token")
  /// Momento em que a doação virou `paid`. É o que decide a janela do sorteio —
  /// `createdAt` é quando o checkout abriu, e um Pix pago horas depois cairia na
  /// janela errada.
  paidAt                  DateTime?      @map("paid_at")
  expiresAt               DateTime?      @map("expires_at")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")

  store    Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaign Campaign?     @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  user     User          @relation(fields: [userId], references: [id])
  payment  Payment?
  entries  RaffleEntry[]

  @@index([campaignId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([storeId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, expiresAt])
  @@index([subscriptionRef])
  @@map("donations")
}

model Raffle {
  id         String    @id @default(uuid()) @db.Uuid
  campaignId String    @map("campaign_id") @db.Uuid
  /// Ordem dentro da campanha e identidade na URL. Atribuída pelo servidor.
  sequence   Int
  title      String
  /// Janela de validade: a doação concorre ao sorteio cuja janela contém o pagamento.
  /// `endsAt` nulo é o sorteio corrente — só o de maior `startsAt` pode ficar sem fim.
  startsAt   DateTime  @map("starts_at")
  endsAt     DateTime? @map("ends_at")

  centsPerNumber Int          @map("cents_per_number")
  drawAt         DateTime?    @map("draw_at")
  status         RaffleStatus @default(open)
  seed           String?
  algorithm      String       @default("sha256-counter-v1")
  drawnAt        DateTime?    @map("drawn_at")
  nextNumber     Int          @default(1) @map("next_number")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  campaign Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  prizes   RafflePrize[]
  entries  RaffleEntry[]

  @@unique([campaignId, sequence])
  @@index([campaignId, startsAt])
  @@map("raffles")
}

model RafflePrize {
  id            String   @id @default(uuid()) @db.Uuid
  raffleId      String   @map("raffle_id") @db.Uuid
  position      Int
  title         String
  /// Prêmio é texto livre, não aponta para Product: sorteio costuma rifar coisa doada
  /// que nunca esteve no catálogo da loja.
  description   String?
  images        String[] @default([])
  winnerEntryId String?  @unique @map("winner_entry_id") @db.Uuid

  raffle      Raffle       @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  winnerEntry RaffleEntry? @relation(fields: [winnerEntryId], references: [id])

  @@unique([raffleId, position])
  @@map("raffle_prizes")
}

model RaffleEntry {
  id         String   @id @default(uuid()) @db.Uuid
  raffleId   String   @map("raffle_id") @db.Uuid
  donationId String   @map("donation_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  number     Int
  createdAt  DateTime @default(now()) @map("created_at")

  raffle   Raffle       @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  donation Donation     @relation(fields: [donationId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id])
  wonPrize RafflePrize?

  @@unique([raffleId, number])
  @@index([raffleId, donationId])
  @@index([userId])
  @@map("raffle_entries")
}
