generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  passwordHash  String?  @map("password_hash")
  googleId      String?  @unique @map("google_id")
  name          String
  phone         String?
  emailVerified Boolean  @default(false) @map("email_verified")
  platformAdmin Boolean  @default(false) @map("platform_admin")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  emailTokens   EmailToken[]
  storeRoles    UserStoreRole[]
  orders        Order[]

  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

enum EmailTokenType {
  verify_email
  password_reset
}

model EmailToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  type      EmailTokenType
  tokenHash String         @unique @map("token_hash")
  expiresAt DateTime       @map("expires_at")
  usedAt    DateTime?      @map("used_at")
  createdAt DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

enum StoreStatus {
  pending
  active
  suspended
}

enum StoreRole {
  owner
  admin
  staff
}

enum ProductAvailability {
  in_stock
  on_demand
}

model Store {
  id                String      @id @default(uuid()) @db.Uuid
  slug              String      @unique
  name              String
  description       String?
  branding          Json?
  status            StoreStatus @default(pending)
  isPlatformOwner   Boolean     @default(false) @map("is_platform_owner")
  applicationFeeBps Int         @default(500) @map("application_fee_bps")
  stripeAccountId   String?     @map("stripe_account_id")
  wooviPixKey       String?     @map("woovi_pix_key")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  roles    UserStoreRole[]
  products Product[]
  orders   Order[]

  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@map("stores")
}

model UserStoreRole {
  userId    String    @map("user_id") @db.Uuid
  storeId   String    @map("store_id") @db.Uuid
  role      StoreRole
  createdAt DateTime  @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@index([storeId])
  @@map("user_store_roles")
}

model Product {
  id           String              @id @default(uuid()) @db.Uuid
  storeId      String              @map("store_id") @db.Uuid
  slug         String
  name         String
  description  String?
  priceCents   Int                 @map("price_cents")
  currency     String              @default("BRL")
  images       String[]            @default([])
  stock        Int                 @default(0)
  availability ProductAvailability @default(in_stock)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([storeId, slug])
  @@index([storeId, active, createdAt(sort: Desc), id(sort: Desc)])
  @@map("products")
}

enum OrderStatus {
  pending_payment
  paid
  delivery_arranged
  delivered
  cancelled
  refunded
}

enum PaymentProvider {
  stripe
  woovi
}

enum PaymentStatus {
  pending
  succeeded
  failed
  expired
  cancelled
  refunded
  refund_pending
}

enum WebhookEventStatus {
  received
  processed
  failed
}

enum OutboxStatus {
  pending
  processing
  processed
  failed
}

model Order {
  id           String      @id @default(uuid()) @db.Uuid
  storeId      String      @map("store_id") @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  status       OrderStatus @default(pending_payment)
  totalCents   Int         @map("total_cents")
  currency     String      @default("BRL")
  contactPhone String      @map("contact_phone")
  note         String?
  expiresAt    DateTime    @map("expires_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  store   Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id])
  items   OrderItem[]
  payment Payment?

  @@index([storeId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, expiresAt])
  @@map("orders")
}

model OrderItem {
  id         String @id @default(uuid()) @db.Uuid
  orderId    String @map("order_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid
  name       String
  priceCents Int    @map("price_cents")
  qty        Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                  String          @id @default(uuid()) @db.Uuid
  orderId             String?         @unique @map("order_id") @db.Uuid
  provider            PaymentProvider
  providerId          String?         @map("provider_id")
  amountCents         Int             @map("amount_cents")
  applicationFeeCents Int             @map("application_fee_cents")
  status              PaymentStatus   @default(pending)
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("payments")
}

model WebhookEvent {
  id          String             @id @default(uuid()) @db.Uuid
  provider    PaymentProvider
  eventId     String             @map("event_id")
  type        String
  payload     Json
  status      WebhookEventStatus @default(received)
  error       String?
  processedAt DateTime?          @map("processed_at")
  createdAt   DateTime           @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@index([status, createdAt])
  @@map("webhook_events")
}

model OutboxEvent {
  id          String       @id @default(uuid()) @db.Uuid
  type        String
  payload     Json
  status      OutboxStatus @default(pending)
  attempts    Int          @default(0)
  processedAt DateTime?    @map("processed_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}
