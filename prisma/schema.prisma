generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  passwordHash  String?  @map("password_hash")
  googleId      String?  @unique @map("google_id")
  name          String
  phone         String?
  emailVerified Boolean  @default(false) @map("email_verified")
  platformAdmin Boolean  @default(false) @map("platform_admin")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  emailTokens   EmailToken[]
  storeRoles    UserStoreRole[]

  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

enum EmailTokenType {
  verify_email
  password_reset
}

model EmailToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  type      EmailTokenType
  tokenHash String         @unique @map("token_hash")
  expiresAt DateTime       @map("expires_at")
  usedAt    DateTime?      @map("used_at")
  createdAt DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

enum StoreStatus {
  pending
  active
  suspended
}

enum StoreRole {
  owner
  admin
  staff
}

enum ProductAvailability {
  in_stock
  on_demand
}

model Store {
  id                String      @id @default(uuid()) @db.Uuid
  slug              String      @unique
  name              String
  description       String?
  branding          Json?
  status            StoreStatus @default(pending)
  isPlatformOwner   Boolean     @default(false) @map("is_platform_owner")
  applicationFeeBps Int         @default(500) @map("application_fee_bps")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  roles    UserStoreRole[]
  products Product[]

  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@map("stores")
}

model UserStoreRole {
  userId    String    @map("user_id") @db.Uuid
  storeId   String    @map("store_id") @db.Uuid
  role      StoreRole
  createdAt DateTime  @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@index([storeId])
  @@map("user_store_roles")
}

model Product {
  id           String              @id @default(uuid()) @db.Uuid
  storeId      String              @map("store_id") @db.Uuid
  slug         String
  name         String
  description  String?
  priceCents   Int                 @map("price_cents")
  currency     String              @default("BRL")
  images       String[]            @default([])
  stock        Int                 @default(0)
  availability ProductAvailability @default(in_stock)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@index([storeId, active, createdAt(sort: Desc), id(sort: Desc)])
  @@map("products")
}
