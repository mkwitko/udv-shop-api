generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  passwordHash  String?  @map("password_hash")
  googleId      String?  @unique @map("google_id")
  name          String
  phone         String?
  emailVerified Boolean  @default(false) @map("email_verified")
  platformAdmin Boolean  @default(false) @map("platform_admin")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  emailTokens   EmailToken[]
  storeRoles    UserStoreRole[]
  orders        Order[]
  interests     ProductInterest[]
  donations     Donation[]
  raffleEntries RaffleEntry[]

  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

enum EmailTokenType {
  verify_email
  password_reset
}

model EmailToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  type      EmailTokenType
  tokenHash String         @unique @map("token_hash")
  expiresAt DateTime       @map("expires_at")
  usedAt    DateTime?      @map("used_at")
  createdAt DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

enum StoreStatus {
  pending
  active
  suspended
}

/// Espelha os status de Subscription do Stripe que nos interessam. `incomplete` é o
/// estado entre o checkout iniciado e o primeiro pagamento confirmado.
enum StoreSubscriptionStatus {
  incomplete
  trialing
  active
  past_due
  canceled
}

enum StoreRole {
  owner
  admin
  staff
}

enum ProductAvailability {
  in_stock
  on_demand
}

enum ProductInterestStatus {
  open
  notified
  converted
  cancelled
}

model Store {
  id                String      @id @default(uuid()) @db.Uuid
  slug              String      @unique
  name              String
  description       String?
  branding          Json?
  status            StoreStatus @default(pending)
  isPlatformOwner   Boolean     @default(false) @map("is_platform_owner")
  applicationFeeBps Int         @default(500) @map("application_fee_bps")
  stripeAccountId   String?     @unique @map("stripe_account_id")
  wooviPixKey       String?     @map("woovi_pix_key")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  // Capacidades da conta conectada, espelhadas do webhook account.updated. Onboarding
  // iniciado não é onboarding concluído: só com chargesEnabled a loja pode cobrar.
  stripeChargesEnabled   Boolean @default(false) @map("stripe_charges_enabled")
  stripePayoutsEnabled   Boolean @default(false) @map("stripe_payouts_enabled")
  stripeDetailsSubmitted Boolean @default(false) @map("stripe_details_submitted")
  wooviSubaccountId      String? @map("woovi_subaccount_id")

  roles        UserStoreRole[]
  products     Product[]
  orders       Order[]
  campaigns    Campaign[]
  donations    Donation[]
  subscription StoreSubscription?

  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@map("stores")
}

/// Assinatura SaaS do núcleo, cobrada na conta da PLATAFORMA (não é Connect: ver ADR-019).
/// Uma por loja — o `@unique` em storeId é o que impede dois checkouts concorrentes
/// virarem duas assinaturas cobradas.
model StoreSubscription {
  id                   String                  @id @default(uuid()) @db.Uuid
  storeId              String                  @unique @map("store_id") @db.Uuid
  stripeCustomerId     String                  @map("stripe_customer_id")
  stripeSubscriptionId String?                 @unique @map("stripe_subscription_id")
  priceId              String?                 @map("price_id")
  status               StoreSubscriptionStatus @default(incomplete)
  currentPeriodEnd     DateTime?               @map("current_period_end")
  cancelAtPeriodEnd    Boolean                 @default(false) @map("cancel_at_period_end")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_subscriptions")
}

model UserStoreRole {
  userId    String    @map("user_id") @db.Uuid
  storeId   String    @map("store_id") @db.Uuid
  role      StoreRole
  createdAt DateTime  @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@index([storeId])
  @@map("user_store_roles")
}

model Product {
  id           String              @id @default(uuid()) @db.Uuid
  storeId      String              @map("store_id") @db.Uuid
  slug         String
  name         String
  description  String?
  priceCents   Int                 @map("price_cents")
  currency     String              @default("BRL")
  images       String[]            @default([])
  stock        Int                 @default(0)
  availability ProductAvailability @default(in_stock)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  interests  ProductInterest[]

  @@unique([storeId, slug])
  @@index([storeId, active, createdAt(sort: Desc), id(sort: Desc)])
  @@map("products")
}

model ProductInterest {
  id         String                @id @default(uuid()) @db.Uuid
  productId  String                @map("product_id") @db.Uuid
  userId     String                @map("user_id") @db.Uuid
  qty        Int                   @default(1)
  status     ProductInterestStatus @default(open)
  note       String?
  notifiedAt DateTime?             @map("notified_at")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, status])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("product_interests")
}

enum OrderStatus {
  pending_payment
  paid
  delivery_arranged
  delivered
  cancelled
  refunded
}

enum PaymentProvider {
  stripe
  woovi
}

enum PaymentStatus {
  pending
  succeeded
  failed
  expired
  cancelled
  refunded
  refund_pending
}

enum WebhookEventStatus {
  received
  processed
  failed
}

enum OutboxStatus {
  pending
  processing
  processed
  failed
}

model Order {
  id           String      @id @default(uuid()) @db.Uuid
  storeId      String      @map("store_id") @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  status       OrderStatus @default(pending_payment)
  totalCents   Int         @map("total_cents")
  currency     String      @default("BRL")
  contactPhone String      @map("contact_phone")
  note         String?
  expiresAt    DateTime    @map("expires_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  store   Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id])
  items   OrderItem[]
  payment Payment?

  @@index([storeId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, expiresAt])
  @@map("orders")
}

model OrderItem {
  id         String @id @default(uuid()) @db.Uuid
  orderId    String @map("order_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid
  name       String
  priceCents Int    @map("price_cents")
  qty        Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                  String          @id @default(uuid()) @db.Uuid
  orderId             String?         @unique @map("order_id") @db.Uuid
  donationId          String?         @unique @map("donation_id") @db.Uuid
  provider            PaymentProvider
  providerId          String?         @map("provider_id")
  amountCents         Int             @map("amount_cents")
  applicationFeeCents Int             @map("application_fee_cents")
  status              PaymentStatus   @default(pending)
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  order    Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  donation Donation? @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("payments")
}

model WebhookEvent {
  id          String             @id @default(uuid()) @db.Uuid
  provider    PaymentProvider
  eventId     String             @map("event_id")
  type        String
  payload     Json
  status      WebhookEventStatus @default(received)
  error       String?
  processedAt DateTime?          @map("processed_at")
  createdAt   DateTime           @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@index([status, createdAt])
  @@map("webhook_events")
}

model OutboxEvent {
  id          String       @id @default(uuid()) @db.Uuid
  type        String
  payload     Json
  status      OutboxStatus @default(pending)
  attempts    Int          @default(0)
  processedAt DateTime?    @map("processed_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  claimedAt   DateTime?    @map("claimed_at")
  claimedBy   String?      @map("claimed_by")

  @@index([status, createdAt])
  @@map("outbox_events")
}

enum CampaignStatus {
  draft
  active
  paused
  finished
}

enum CampaignAcceptedTypes {
  one_time
  monthly
  both
}

enum DonationType {
  one_time
  monthly
}

enum DonationStatus {
  pending_payment
  paid
  failed
  cancelled
  refunded
}

enum RaffleStatus {
  open
  drawn
  cancelled
}

model Campaign {
  id            String                @id @default(uuid()) @db.Uuid
  storeId       String                @map("store_id") @db.Uuid
  slug          String
  title         String
  story         String?
  coverImage    String?               @map("cover_image")
  goalCents     Int?                  @map("goal_cents")
  acceptedTypes CampaignAcceptedTypes @default(both) @map("accepted_types")
  status        CampaignStatus        @default(draft)
  endsAt        DateTime?             @map("ends_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  donations Donation[]
  raffle    Raffle?

  @@unique([storeId, slug])
  @@index([storeId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@map("campaigns")
}

model Donation {
  id                     String         @id @default(uuid()) @db.Uuid
  storeId                String         @map("store_id") @db.Uuid
  campaignId             String?        @map("campaign_id") @db.Uuid
  userId                 String         @map("user_id") @db.Uuid
  type                   DonationType   @default(one_time)
  amountCents            Int            @map("amount_cents")
  currency               String         @default("BRL")
  status                 DonationStatus @default(pending_payment)
  anonymous              Boolean        @default(false)
  message                String?
  subscriptionRef        String?        @map("subscription_ref")
  providerInvoiceId      String?        @unique @map("provider_invoice_id")
  subscriptionCancelledAt DateTime?     @map("subscription_cancelled_at")
  raffleGranted          Boolean        @default(false) @map("raffle_granted")
  expiresAt              DateTime?      @map("expires_at")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  store    Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaign Campaign?     @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  user     User          @relation(fields: [userId], references: [id])
  payment  Payment?
  entries  RaffleEntry[]

  @@index([campaignId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([storeId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, expiresAt])
  @@index([subscriptionRef])
  @@map("donations")
}

model Raffle {
  id             String       @id @default(uuid()) @db.Uuid
  campaignId     String       @unique @map("campaign_id") @db.Uuid
  centsPerNumber Int          @map("cents_per_number")
  drawAt         DateTime?    @map("draw_at")
  status         RaffleStatus @default(open)
  seed           String?
  algorithm      String       @default("sha256-counter-v1")
  drawnAt        DateTime?    @map("drawn_at")
  nextNumber     Int          @default(1) @map("next_number")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  campaign Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  prizes   RafflePrize[]
  entries  RaffleEntry[]

  @@map("raffles")
}

model RafflePrize {
  id            String  @id @default(uuid()) @db.Uuid
  raffleId      String  @map("raffle_id") @db.Uuid
  position      Int
  title         String
  winnerEntryId String? @unique @map("winner_entry_id") @db.Uuid

  raffle      Raffle       @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  winnerEntry RaffleEntry? @relation(fields: [winnerEntryId], references: [id])

  @@unique([raffleId, position])
  @@map("raffle_prizes")
}

model RaffleEntry {
  id         String   @id @default(uuid()) @db.Uuid
  raffleId   String   @map("raffle_id") @db.Uuid
  donationId String   @map("donation_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  number     Int
  createdAt  DateTime @default(now()) @map("created_at")

  raffle   Raffle       @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  donation Donation     @relation(fields: [donationId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id])
  wonPrize RafflePrize?

  @@unique([raffleId, number])
  @@index([raffleId, donationId])
  @@index([userId])
  @@map("raffle_entries")
}
