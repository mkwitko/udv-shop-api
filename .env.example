NODE_ENV=development
PORT=3333
DATABASE_URL=postgresql://udv:udv@localhost:5436/udvshop
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=1
# gerar com: pnpm keys:generate
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_D=30
REFRESH_REUSE_GRACE_S=30
COOKIE_SECRET=troque-por-32-bytes-aleatorios
# true só quando o front está em outro registrable domain que a API (ex.: vercel.app x fly.dev).
# Liga SameSite=None+Secure no cookie de refresh — exige HTTPS nos dois lados.
COOKIE_CROSS_SITE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3333/auth/google/callback
RESEND_API_KEY=
EMAIL_FROM=Lojinha <nao-responda@example.org>
# Stripe (checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_SAAS_PRICE_ID=
STRIPE_CONNECT_COUNTRY=BR
# Woovi (checkout Pix)
# Alvo do CNAME para loja com domínio próprio; vazio desliga a feature
CUSTOM_DOMAIN_TARGET=
# produção: https://api.woovi.com | teste: https://api.woovi-sandbox.com
# O AppID precisa ser do MESMO ambiente desta URL.
WOOVI_BASE_URL=https://api.woovi.com
WOOVI_API_KEY=
# um segredo por webhook da Woovi (pago, expirado, estornado), separados por vírgula
WOOVI_WEBHOOK_HMAC_SECRET=
# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Pix falso com autoconfirmação (~8s) para rodar o checkout local sem credenciais.
# Proibido em produção — o boot recusa.
DEV_FAKE_PAYMENTS=false

# Workers AI (descrição de produto escrita/melhorada por IA). Vazio = feature desligada.
# CF_AI_ACCOUNT_ID cai no R2_ACCOUNT_ID quando não informado (mesma conta Cloudflare).
# O token precisa da permissão "Workers AI: Read" na conta.
CF_AI_ACCOUNT_ID=
CF_AI_API_TOKEN=
CF_AI_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
