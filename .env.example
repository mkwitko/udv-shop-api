NODE_ENV=development
PORT=3333
DATABASE_URL=postgresql://udv:udv@localhost:5436/udvshop
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=1
# gerar com: pnpm keys:generate
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_D=30
REFRESH_REUSE_GRACE_S=30
COOKIE_SECRET=troque-por-32-bytes-aleatorios
# true só quando o front está em outro registrable domain que a API (ex.: vercel.app x fly.dev).
# Liga SameSite=None+Secure no cookie de refresh — exige HTTPS nos dois lados.
COOKIE_CROSS_SITE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3333/auth/google/callback
RESEND_API_KEY=
EMAIL_FROM=Lojinha <nao-responda@example.org>
# Stripe (checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_SAAS_PRICE_ID=
STRIPE_CONNECT_COUNTRY=BR
# Woovi (checkout Pix)
# Alvo do CNAME para loja com domínio próprio; vazio desliga a feature
CUSTOM_DOMAIN_TARGET=
# produção: https://api.woovi.com | teste: https://api.woovi-sandbox.com
# O AppID precisa ser do MESMO ambiente desta URL.
WOOVI_BASE_URL=https://api.woovi.com
WOOVI_API_KEY=
# um segredo por webhook da Woovi (pago, expirado, estornado), separados por vírgula
WOOVI_WEBHOOK_HMAC_SECRET=
# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Pix falso com autoconfirmação (~8s) para rodar o checkout local sem credenciais.
# Proibido em produção — o boot recusa.
DEV_FAKE_PAYMENTS=false

# Workers AI (descrição de produto escrita/melhorada por IA). Vazio = feature desligada.
# CF_AI_ACCOUNT_ID cai no R2_ACCOUNT_ID quando não informado (mesma conta Cloudflare).
# O token precisa da permissão "Workers AI: Read" na conta.
CF_AI_ACCOUNT_ID=
CF_AI_API_TOKEN=
CF_AI_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct

# Turnstile (desafio anti-robô nas escritas sem conta: pedir aviso, doar, comprar).
# Vazio = desligado, e o limite por IP segue sendo a única barreira. A chave pública
# correspondente vai no VITE_TURNSTILE_SITE_KEY do udv-shop-web — configure as duas ou
# nenhuma: só a pública faz o widget aparecer sem ninguém validar o token.
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Só produção: lido pelo docker-compose.prod.yml e pelos scripts em scripts/.
# Em desenvolvimento nada disso é necessário.
# ---------------------------------------------------------------------------

# Imagem da API, sempre com digest. Escrita pelo scripts/deploy-image.sh — não editar à mão.
API_IMAGE=
API_IMAGE_PREVIOUS=

# Token do túnel (painel da Cloudflare > Networking > Tunnels > Add a replica).
TUNNEL_TOKEN=

# Senhas do Postgres. POSTGRES_PASSWORD é o superusuário de bootstrap; as outras três são
# os roles de privilégio mínimo criados no primeiro boot (deploy/postgres/initdb/01-roles.sh).
# Só valem no initdb: trocar depois exige ALTER ROLE ... PASSWORD no banco.
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATE_PASSWORD=
POSTGRES_BACKUP_PASSWORD=

# Em produção a API usa udv_app (só DML) e o migrate usa udv_migrate (DDL). O host é
# `postgres` porque é o nome do serviço na rede do compose. A DATABASE_URL de produção
# substitui a de desenvolvimento no topo deste arquivo:
# DATABASE_URL=postgresql://udv_app:<POSTGRES_APP_PASSWORD>@postgres:5432/udvshop?connection_limit=10&pool_timeout=20&connect_timeout=5
MIGRATE_DATABASE_URL=

# Bucket de backup, separado do de uploads, com token escopado só a ele.
R2_BACKUP_BUCKET=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=

# Chave pública age (age-keygen). A privada fica em BACKUP_AGE_KEY_FILE (600) e também num
# gerenciador de senhas fora da VM — sem a segunda cópia, perder a VM perde os backups.
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_KEY_FILE=/opt/udv-shop/.age-key

# Dead man's switch (healthchecks.io). Vazio desliga o alerta — e aí ninguém descobre que o
# backup parou de rodar. Criar as três em modo Simple (não cron): as units derrapam de
# horário de propósito. O OnFailure das units chama scripts/alert.sh, que escolhe a URL
# certa pelo nome da unit — falha do host-check não marca o check do backup como quebrado.
BACKUP_HEALTHCHECK_URL=
RESTORE_CHECK_HEALTHCHECK_URL=
HOST_CHECK_HEALTHCHECK_URL=
